<div class="form-page">
  <div class="form-card">
    <h1>Edit Pet</h1>

 <%= simple_form_for(@pet) do |f| %>
      <%= f.input :name %>


<div class="mb-3">
  <h6>Age</h6>
  <div class="d-flex align-items-center gap-2">

  <%= f.select :age_years,
      (0..30).to_a,
      { prompt: "Year" },
      { class: "form-select" } %>

  <span>Years</span>

  <%= f.select :age_months,
      (0..11).to_a,
      { prompt: "Month" },
      { class: "form-select" } %>

  <span>Months</span>

</div>


<div id="other-species-field">
    <%= f.input :species%>
  </div>

  <div id="other-breed-field">
    <%= f.input :breed %>
  </div>




  <%= f.input :weight, label: "Weight (kg)" %>

  <div class="d-flex justify-content-center">

  <%= f.button :submit, "Update Pet", class: "button-add-pet d-flex" %>
<% end %>
</div>
</div>
