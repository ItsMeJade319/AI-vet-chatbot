<div class="form-page">
  <div class="form-card">
    <h1>Edit Pet</h1>

 <%= simple_form_for(@pet) do |f| %>
      <%= f.input :name %>


<div class="mb-3">
  <h6>Age</h6>
  <div class="d-flex align-items-center gap-2">

  <%= f.select :age,
      (0..30).to_a,
      { prompt: "Year" },
      { class: "form-select" } %>

  <span>Years</span>

  <%= f.select :age,
      (0..11).to_a,
      { prompt: "Month" },
      { class: "form-select" } %>

  <span>Months</span>

</div>

<%= f.input :species,
    collection: ["Dog", "Cat", "Rabbit", "Bird", "Other"],
    prompt: "Select a species",
    input_html: { id: "species-select" } %>


<%= f.input :breed,
    collection: [
      "Golden Retriever",
      "Poodle",
      "Beagle",
      "Persian",
      "Siamese",
      "British Shorthair",
      "Holland Lop",
      "Lionhead",
      "Cockatiel",
      "Parakeet",
      "Other"
    ],
    prompt: "Select a breed" %>

<div id="other-breed-field" style="display: none;">
  <%= f.input :breed,
      label: "If other, please specify",
      required: false %>
</div>


  <%= f.input :weight, label: "Weight (kg)" %>

  <%= f.button :submit, "Update Pet", class: "btn-primary-custom d-flex" %>
<% end %>
</div>
</div>
