
<% if @pet.errors.any? %>
  <div class="alert alert-danger">
    <ul>
      <% @pet.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="form-page">
  <div class="form-card">
    <h1>Add a New Pet</h1>



   <%= simple_form_for(@pet) do |f| %>
      <%= f.input :name %>


<div class="mb-3">
  <h6>Age</h6>

  <div class="d-flex align-items-center gap-2">

  <%= f.select :age,
      (0..30).to_a,
      { prompt: "Year" },
      { class: "form-select" } %>

  <span>Years</span>

  <%= f.select :age,
      (0..11).to_a,
      { prompt: "Month" },
      { class: "form-select" } %>

  <span>Months</span>

</div>

<%= f.input :species,
    collection: ["Dog", "Cat", "Rabbit", "Bird", "Other"],
    prompt: "Select a species",
    input_html: { id: "species-select" } %>

<div id="other-species-field" style="display: none;">
  <%= f.input :species,
      label: "If other, please specify",
      required: false %>
</div>

<%= f.input :breed,
    collection: [],
    prompt: "Select a breed",
    input_html: { id: "breed-select" } %>

<div id="other-breed-field" style="display: none;">
  <%= f.input :breed,
      label: "If other, please specify",
      required: false %>
</div>




  <%= f.input :weight, label: "Weight (kg)" %>

  <%= f.button :submit, class: "btn-primary-custom d-flex"%>
<% end %>
</div>
</div>
