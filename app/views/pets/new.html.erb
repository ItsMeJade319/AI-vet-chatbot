
<div class="form-page">
  <div class="form-card">
    <h1>Add a New Pet</h1>

<%= simple_form_for @pet do |f| %>
  <%= f.input :name %>


<div class="mb-3">
  <label class="form-label">Age</label>

  <div class="d-flex gap-2">
    <%= f.select :age,
        (0..30).to_a,
        { prompt: "Years" },
        { class: "form-select" } %>

    <%= f.select :age,
        (0..11).to_a,
        { prompt: "Months" },
        { class: "form-select" } %>
  </div>
</div>

    <%= f.input :species,
    collection: ["Dog", "Cat", "Rabbit", "Bird", "Other"],
    prompt: "Select a species",
    input_html: { id: "species-select" } %>

<%= f.input :breed,
    collection: [],
    prompt: "Select a breed",
    input_html: { id: "breed-select" } %>


  <%= f.input :weight, label: "Weight (kg)" %>

  <%= f.button :submit, class: "btn-primary-custom d-flex"%>
<% end %>
</div>
</div>
