
<div class="form-page">
  <div class="form-card">
      <h1>Add a New Pet</h1>



    <%= simple_form_for(@pet) do |f| %>
        <%= f.input :name %>


  <div class="mb-3">
    <h6>Age</h6>

    <div class="d-flex align-items-center gap-2">

    <%= f.select :age_years,
        (0..30).to_a,
        { prompt: "Year" },
        { class: "form-select" } %>


    <%= f.select :age_months,
        (0..11).to_a,
        { prompt: "Month" },
        { class: "form-select" } %>


  </div>

  <div id="other-species-field">
    <%= f.input :species%>
  </div>

  <div id="other-breed-field">
    <%= f.input :breed %>
  </div>




    <%= f.input :weight, label: "Weight (kg)" %>

    <%= f.button :submit, class: "btn-primary-custom d-flex"%>
  <% end %>
  </div>
  </div>
</div>
