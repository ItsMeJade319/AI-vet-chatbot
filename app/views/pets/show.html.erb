<div class="d-flex flex-row vh-100">

  <div class="h-100 border" style="width: 300px">
    <div>
      <%= link_to "New Chat", "#", class: "button-newchat mb-5" %>
    </div>

    <div class="card mx-2">
      <div class="card-body ">
        <div class="d-flex flex-row align-items-center">
          <div class="rounded-circle border d-flex align-items-center justify-content-center me-2" style="width: 50px; height: 50px; font-size: 35px; line-height: 1; ">🐕</div>

          <div class="">
            <h3 style="margin-bottom: -3px"><%= @pet.name %></h3>
            <span style="font-size: 13px"><%= @pet.breed %></span>
            <span style="font-size: 13px"><%= @pet.age %>y</span>
            <span style="font-size: 13px"><%= @pet.weight %> kg</span>
          </div>
        </div>
      </div>
    </div>

    <div class="column ms-4 my-4">
      <p style="font-size: 12px">RECENT CONVERSATIONS</p>
    </div>
  </div>



  <div class="h-100 border">

    </div>
  </div>
