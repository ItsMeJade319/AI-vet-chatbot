
<div class="d-flex flex-row vh-100">

  <div class="h-100 border d-flex flex-column" style="width: 400px;" id="sidebar">

    <div>
      <%= link_to "New Chat", new_pet_problem_path(@pet), class: "button-newchat mb-5", data: { turbo_stream: true } %>
    </div>

    <%= link_to pet_path(@pet), class: "text-decoration-none text-dark d-block mx-2" do %>
      <div class="card" style="background: #f6f6c4;">
        <div class="card-body">
          <div class="d-flex flex-row align-items-center">
            <div class="rounded-circle border d-flex align-items-center justify-content-center me-2" style="width: 50px; height: 50px; font-size: 35px; line-height: 1;">
            <% if @pet.species == "dog" %>
              🐕
            <% elsif @pet.species == "cat" %>
              🐈
            <% else %>
              🐾
            <% end %>

            </div>

            <div class="">
              <h3 style="margin-bottom: -3px"><%= @pet.name %></h3>
              <span style="font-size: 13px"><%= @pet.breed %></span>
              <span style="font-size: 13px"><%= @pet.age_years %> years</span>
              <span style="font-size: 13px"><%= @pet.age_months %> months</span>
              <span style="font-size: 13px"><%= @pet.weight %> kg</span>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <div class="column ms-4 my-4">
      <p style="font-size: 12px">RECENT CONVERSATIONS</p>
    </div>

      <div class="column flex-grow-1 overflow-y-auto" style="min-height: 0;">
        <% if @problems.count > 0 %>
          <% @problems.each do |problem|%>
            <%= render "pets/problem", problem: problem %>
          <% end %>
        <% end %>
      </div>
    </div>



    <div class="h-100 w-100" id="main_panel">

      <div id="pet-details">
        <div class="mx-auto mt-5" style="max-width: 600px">
          <div style="text-align: center">
            <p style="font-size: 24px; font-weight: 700;">How can I help   <span style="background-image: linear-gradient(to right, #ff7e5f, #feb47b); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; color: transparent; display: inline-block;">
            <%= @pet.name.capitalize %></span> today?</p>
            <p>Ask me anything about <%= @pet.name.capitalize %>'s health, nutrition, behavior, or care. I'm here to provide personalized veterinary guidance.</p>
          </div>
        <div class="card mx-2">
          <div class="card-body ">
            <div class="d-flex justify-content-between align-items-center ">

              <div class="d-flex">
                <div class="rounded-circle border d-flex align-items-center justify-content-center me-2" style="width: 50px; height: 50px; font-size: 35px; line-height: 1; ">
                  <% if @pet.species == "dog" %>
                    🐕
                  <% elsif @pet.species == "cat" %>
                    🐈
                  <% else %>
                    🐾
                  <% end %>
                </div>

                <div class="">
                  <h3 style="margin-bottom: -3px"><%= @pet.name %></h3>
                  <span style="font-size: 13px"><%= @pet.breed %></span>
                  <span style="font-size: 13px"><%= @pet.age_years %> years</span>
                   <span style="font-size: 13px"><%= @pet.age_months %> months</span>
                  <span style="font-size: 13px"><%= @pet.weight %> kg</span>
                </div>
              </div>
                <div>
                  <%= link_to "Add vaccines", new_pet_vaccination_path(@pet), class: "button-vaccines ms-auto "%>
                </div>
            </div>



<div class="mt-4">

  <% if @vaccinations.any? %>

    <% @vaccinations.each_with_index do |vaccination, index| %>

      <div class="d-flex justify-content-between align-items-center border-bottom py-3">

        <div>
          <span class="fw-bold me-2"><%= index + 1 %>.</span>
          <%= vaccination.brand %>
        </div>

        <%= link_to "Edit",
            edit_pet_vaccination_path(@pet, vaccination),
            class: "btn btn-sm btn-outline-secondary" %>

      </div>

    <% end %>

  <% else %>

    <p class="text-muted mb-0">
      No vaccinations recorded yet.
    </p>

  <% end %>

</div>

</div>
          </div>
        </div>

</div>
