<h1><%= @pet.name %></h1>

<p>Breed: <%= @pet.breed %></p>
<p>Age: <%= @pet.age %></p>
<p>Vaccination: <%= @pet.vaccinations %></p>


<%= link_to pet_path(@pet), class: "text-decoration-none" do %>
  <div class="card">
    <div class="card-body">
      <h5><%= @pet.name %></h5>
    </div>
  </div>
<% end %>

<h1><%= @pet.name %></h1>

<h2>Vaccinations</h2>

<% if @pet.vaccinations.any? %>
  <% @pet.vaccinations.each do |vaccination| %>
    <div class="card mb-3">
      <div class="card-body">
        <p><strong>Brand:</strong> <%= vaccination.brand %></p>
        <p><strong>Diseases:</strong> <%= vaccination.diseases %></p>
        <p><strong>Target Species:</strong> <%= vaccination.target_species %></p>
        <p><strong>Description:</strong> <%= vaccination.description %></p>
      </div>
    </div>
  <% end %>
<% else %>
  <p>No vaccination records found.</p>
<% end %>
