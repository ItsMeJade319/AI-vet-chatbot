<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>My Pets</h1>

<div class="d-flex gap-2">
    <%= link_to "Add Pet",
        new_pet_path,
        class: "button-add-pet" %>
    <%=button_to "Logout",
        destroy_user_session_path, method: :delete,
        form: { data: { turbo_confirm: "Are you sure you want to log out?" } },
        class: "button-loggout" %>
   </div>
  </div>
  <div class="row">
    <% @pets.each do |pet| %>
      <div class="col-md-4 mb-4">
        <div class="card shadow-sm">
          <div class="card-body d-flex flex-row justify-content-between align-items-center">
            <div class="d-flex flex-row align-items-center">
              <div class="rounded-circle border d-flex align-items-center justify-content-center me-2" style="width: 50px; height: 50px; font-size: 35px; line-height: 1;">

                <% if pet.species == "dog" %>
                    🐕
                <% elsif pet.species == "cat" %>
                    🐈
                <% else %>
                    🐾
                <% end %>
              </div>
              <h5 class="card-title mb-0"><%= pet.name.capitalize %></h5>
            </div>
            <%= link_to "View",
                pet_path(pet),
                class: "button-view" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div class="cat-container">
  <div class="cat">
    <div class="tail"></div>

    <div class="body">
      <div class="head">
        <div class="ear ear-left"></div>
        <div class="ear ear-right"></div>

        <div class="eye eye-left"></div>
        <div class="eye eye-right"></div>

        <div class="nose"></div>
      </div>
    </div>
  </div>
</div>
<div class="grass"></div>
