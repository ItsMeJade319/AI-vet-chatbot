<div class="mx-auto mt-5" style="max-width: 750px">

<h1><%= @problem.title %></h1>
<hr>

<% @problem.messages.each do |message| %>
  <% if message.role == "user" %>
    <div class="d-flex justify-content-end mb-2">
      <div class="bg-white px-3 py-2 rounded-pill d-flex align-items-center">
        <%= message.content %>
      </div>
    </div>

  <% elsif message.role == "assistant" %>
    <div class="d-flex justify-content-start mb-5">
      <div class="px-3 py-2 d-flex align-items-center">
        <%= message.content %>
      </div>
    </div>
  <% end %>
<% end %>


<%= simple_form_for [problem, message] do |f| %>
  <%= f.input :content,
    as: :text,
    label: "Ask a question",
    required: true,
    input_html: {
      rows: 5,
      placeholder: "Ask for help"
    } %>

  <%= f.button :submit, 'Ask the Vet', class: 'button-add-pet d-flex' %>
<% end %>
</div>
