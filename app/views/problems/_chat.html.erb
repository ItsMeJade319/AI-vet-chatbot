<div class="chat-shell">
  <div class="chat-header">
    <div class="mx-auto" style="max-width: 880px;">
      <h1 class="chat-title"><%= problem.title %></h1>
    </div>
  </div>

  <div class="chat-thread">
    <div class="chat-thread-inner">
      <% problem.messages.each do |chat_message| %>
        <% if chat_message.role == "user" %>
          <div class="chat-row chat-row-user">
            <div class="chat-bubble chat-bubble-user">
              <%= chat_message.content %>
            </div>
          </div>
        <% elsif chat_message.role == "assistant" %>
          <div class="chat-row chat-row-assistant">
            <div class="chat-bubble chat-bubble-assistant">
              <%= raw(render_markdown(chat_message.content)) %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="chat-composer">
    <div class="chat-composer-card">
      <%= simple_form_for [problem, message], html: { class: "chat-form" } do |f| %>
        <%= f.input :content,
                    as: :text,
                    label: false,
                    required: true,
                    placeholder: "Ask for help",
                    input_html: { rows: 1 } %>
        <div class="d-flex justify-content-end">
          <%= f.button :submit, "Ask LLM", class: "chat-form-submit" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
